# Paste into Dokploy → Environment. Never commit real values.
APP_URL=https://correo.postor.do
# Shared with the relay Worker (wrangler secret put INBOUND_WEBHOOK_SECRET).
INBOUND_WEBHOOK_SECRET=
INBOUND_REQUIRE_SIGNED_HEADERS=1
# Sending: Cloudflare Email Sending, or SMTP_URL / Resend / SES.
CF_ACCOUNT_ID=
CF_TOKEN=
#SMTP_URL=smtps://user:pass@host:465
#RESEND_API_KEY=
# Optional: Postgres instead of SQLite on the volume.
#DATABASE_URL=postgresql://user:pass@host:5432/mailflare
# Optional: push notifications (npm run push:keys).
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@postor.do
